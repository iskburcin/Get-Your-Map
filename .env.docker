# Optional: Add your GitHub Personal Access Token for higher API rate limits
# Get one at https://github.com/settings/tokens (just need "repo" scope)
GITHUB_TOKEN=

# MongoDB settings
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=github_info_ui

# Ollama settings (local service in compose stack)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Internal service URLs (do not change)
BACKEND_BASE_URL=http://server:4000
