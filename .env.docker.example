# Copy this file to .env.docker and edit values as needed.
# Usage: docker compose --env-file .env.docker up --build

# Required for better GitHub API rate limits
GITHUB_TOKEN=

# MongoDB settings (defaults target the compose mongo service)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=github_info_ui

# Ollama settings
# If running Ollama container in this compose stack:
OLLAMA_URL=http://ollama:11434
# If using Ollama from your host machine instead, uncomment next line and disable/remove ollama service.
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Client -> server base URL inside compose network
BACKEND_BASE_URL=http://server:4000
